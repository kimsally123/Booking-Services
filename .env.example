# คัดลอกเป็น .env.local แล้วใส่ค่าจริง · ห้าม commit ไฟล์ที่มีค่าจริง
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ใช้ pooler แบบ session port 5432 (ถ้าใส่ 6543 ระบบเปลี่ยนเป็น 5432 ให้เอง เพราะ 6543 ค้างเมื่อยิงคำสั่งพร้อมกัน)
SUPABASE_DB_URL=

# ที่อยู่เว็บ (ไม่ใส่ก็ได้ บน Vercel ใช้โดเมน production ให้อัตโนมัติ)
APP_URL=

# LINE
# LIFF ID ใส่ในหลังบ้านแทนได้ (ตั้งค่า → รับเงินและข้อมูลร้าน) · channel ID ระบบอ่านจาก LIFF ID ให้
NEXT_PUBLIC_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Channel secret ของ Messaging API (ตรวจลายเซ็น webhook)
LINE_CHANNEL_SECRET=

# อีเมลแจ้งร้าน (Resend) · ผู้รับตั้งใน settings.notify_email
EMAIL_API_KEY=
EMAIL_FROM=

# อ่านสลิปอัตโนมัติ (Google Cloud Vision · ฟรี 1,000 รูป/เดือน ต้องผูกบัตรใน Google Cloud)
# ไม่ใส่ก็ได้: ระบบยังอ่าน QR ในสลิปเพื่อกันสลิปซ้ำ แต่พนักงานต้องดูยอดเอง · จำกัดต่อเดือนที่ settings.ocr_month_limit
GOOGLE_VISION_API_KEY=

# Google Calendar (ทั้งไฟล์ JSON ของ service account บรรทัดเดียว)
GOOGLE_SERVICE_ACCOUNT_JSON=

# เซ็นคุกกี้ล็อกอิน (สุ่มยาว ≥ 32 ตัว เช่น openssl rand -hex 32)
SESSION_SECRET=

# ป้องกันรอบตั้งเวลา /api/cron/tick
CRON_SECRET=

# โหมดเดโม่ (เครื่อง dev / ตัวเดโม่ขายร้านอื่นเท่านั้น · ห้ามเปิดบนระบบจริงของร้าน)
# DEMO_MODE=1 → ใช้ลูกค้าสมมติ DEMO_CUSTOMER และเปิดหลังบ้านโดยไม่ต้องล็อกอิน
DEMO_MODE=
DEMO_CUSTOMER=C002
DEMO_STAFF=ST01
